---
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { features } from '../content/site';
---

<section class="section--mint features" aria-labelledby="features-title">
  <h2 id="features-title" class="visually-hidden">{features.heading}</h2>
  <ul class="container features__list">
    {
      features.items.map((item) => (
        <li class="feature">
          <Icon name={item.icon} size={44} class="feature__icon" />
          <h3 class="feature__title">{item.title}</h3>
          <p class="feature__body">
            <Lines lines={item.lines} always />
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features__list {
    display: grid;
    padding-block: 16px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 32px;
    text-align: center;
  }

  .feature + .feature {
    border-top: 1px solid var(--color-mint-deep);
  }

  .feature :global(.feature__icon) {
    color: var(--color-primary);
  }

  .feature__title {
    margin-top: 14px;
    font-size: 19px;
  }

  .feature__body {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.85;
  }

  @media (min-width: 768px) {
    .features__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-block: 56px;
    }

    .feature {
      padding: 4px 16px;
    }

    .feature + .feature {
      border-top: 0;
      border-left: 1px solid #cfe6df;
    }

    .feature__title {
      font-size: 20px;
    }

    .feature__body {
      font-size: 16px;
    }
  }
</style>
