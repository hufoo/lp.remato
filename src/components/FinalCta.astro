---
import CtaBlock from './CtaBlock.astro';
import { finalCta } from '../content/site';
---

<section class="section final-cta" aria-labelledby="final-cta-title">
  <div class="container">
    <h2 id="final-cta-title" class="section-title final-cta__title jp-wrap">{finalCta.title}</h2>
    <CtaBlock />
  </div>
</section>

<style>
  .final-cta__title {
    margin-bottom: 28px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .final-cta {
      padding-block: 80px;
    }

    .final-cta__title {
      margin-bottom: 32px;
    }
  }
</style>
