---
/** Inline line icons. Decorative by default. */
export type IconName = 'calculator' | 'cart' | 'repeat' | 'check' | 'arrow-right';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'calculator' && (
      <>
        <rect x="4.5" y="2" width="15" height="20" rx="2.5" />
        <rect x="7.5" y="5" width="9" height="4" rx="0.5" />
        <path d="M8 13h.01M12 13h.01M16 13h.01M8 16.5h.01M12 16.5h.01M16 16.5h.01" stroke-width="2.6" />
      </>
    )
  }
  {
    name === 'cart' && (
      <>
        <path d="M2 3h2.6l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.9a1.5 1.5 0 0 0 1.5-1.1L21 7H6" />
        <circle cx="9" cy="20" r="1.4" />
        <circle cx="17.5" cy="20" r="1.4" />
      </>
    )
  }
  {
    name === 'repeat' && (
      <>
        <path d="M20 11a8 8 0 0 0-14.3-4.9" />
        <path d="M5 2.5v4h4" />
        <path d="M4 13a8 8 0 0 0 14.3 4.9" />
        <path d="M19 21.5v-4h-4" />
      </>
    )
  }
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6" />}
</svg>
